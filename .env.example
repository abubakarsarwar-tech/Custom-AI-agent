# LCA — Local Code Agent configuration
# Copy to .env (or your shell profile) and adjust. Everything here is optional;
# the defaults work for a 16 GB laptop with qwen2.5-coder:7b pulled.
#
# Precedence: built-in defaults -> .agent/config.json -> these env vars -> CLI flags.

# ---- model -------------------------------------------------------------
# Which local model to use. Must be pulled first:  ollama pull <tag>
LCA_MODEL=qwen2.5-coder:7b

# Where Ollama is listening. Change only if you moved it or use a remote box.
LCA_OLLAMA_URL=http://127.0.0.1:11434

# ollama | mock   (mock replays a scripted model — no Ollama needed)
LCA_PROVIDER=ollama

# ---- context & sampling ------------------------------------------------
# THE most important setting. Ollama defaults to 2048-4096 tokens, which is far
# too small for an agent that reads files. Costs roughly 1 GB of RAM per 8k on a
# 7B model, so raise it only as far as your machine allows.
LCA_NUM_CTX=8192

# Low temperature for code. 0.0 = most deterministic, 0.3 = more creative.
LCA_TEMPERATURE=0.1

# How long Ollama keeps the model weights in RAM between requests.
LCA_KEEP_ALIVE=20m

# ---- agent behaviour ---------------------------------------------------
# Max think->tool->observe rounds per request before it force-stops.
LCA_MAX_STEPS=25

# ask | auto | readonly
#   ask      = confirm every write and shell command (default, safest)
#   auto     = never ask, but catastrophic commands are still hard-blocked
#   readonly = no writes, no shell at all
LCA_PERMISSION_MODE=ask

# Project root the agent is jailed to. Defaults to the current directory.
LCA_WORKSPACE=

# Kill any shell command after this many milliseconds.
LCA_BASH_TIMEOUT_MS=120000

# Comma-separated tool names to auto-approve even in "ask" mode,
# e.g. LCA_AUTO_APPROVE=read_file,search,list_dir
LCA_AUTO_APPROVE=
