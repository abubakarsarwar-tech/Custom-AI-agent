# LCA — Local Code Agent configuration
# Copy to .env (or your shell profile) and adjust. Everything here is optional;
# the defaults work for a 16 GB laptop with qwen2.5-coder:7b pulled.
#
# Precedence: built-in defaults -> .agent/config.json -> these env vars -> CLI flags.

# ---- model -------------------------------------------------------------
# Which local model to use. Must be pulled first:  ollama pull <tag>
LCA_MODEL=qwen2.5-coder:7b

# Where Ollama is listening. Change only if you moved it or use a remote box.
LCA_OLLAMA_URL=http://127.0.0.1:11434

# ollama | mock   (mock replays a scripted model — no Ollama needed)
LCA_PROVIDER=ollama

# ---- context & sampling ------------------------------------------------
# THE most important setting. Ollama defaults to 2048-4096 tokens, which is far
# too small for an agent that reads files. Costs roughly 1 GB of RAM per 8k on a
# 7B model, so raise it only as far as your machine allows.
LCA_NUM_CTX=8192

# Low temperature for code. 0.0 = most deterministic, 0.3 = more creative.
LCA_TEMPERATURE=0.1

# How long Ollama keeps the model weights in RAM between requests.
LCA_KEEP_ALIVE=20m

# ---- agent behaviour ---------------------------------------------------
# Max think->tool->observe rounds per request before it force-stops.
LCA_MAX_STEPS=25

# ask | auto | readonly
#   ask      = confirm every write and shell command (default, safest)
#   auto     = never ask, but catastrophic commands are still hard-blocked
#   readonly = no writes, no shell at all
LCA_PERMISSION_MODE=ask

# Project root the agent is jailed to. Defaults to the current directory.
LCA_WORKSPACE=

# Kill any shell command after this many milliseconds.
LCA_BASH_TIMEOUT_MS=120000

# Comma-separated tool names to auto-approve even in "ask" mode,
# e.g. LCA_AUTO_APPROVE=read_file,search,list_dir
LCA_AUTO_APPROVE=

# ---- skills --------------------------------------------------------------
# Modular expertise (code / design / debug / test / ...). Only names and
# one-line descriptions enter the system prompt (~450 tokens for all ten);
# a full skill body is loaded only when that skill is actually used.
LCA_SKILLS=true

# Load the best-matching skill automatically instead of spending a round-trip
# asking the model to choose. Ambiguous requests are left to the model either way.
LCA_SKILLS_AUTO=true

# Extra folders to search for SKILL.md, comma-separated.
# Default search order (later wins): bundled skills/ -> ~/.config/local-code-agent/skills/
#   -> <project>/.agent/skills/ -> <project>/skills/
LCA_SKILLS_DIRS=

# Hard cap on how much of ONE skill body may enter the context.
LCA_SKILLS_MAX_BODY=12000

# ---- memory --------------------------------------------------------------
# Cross-session memory: corrections and conventions written to
# <project>/.agent/memory/lessons.jsonl and recalled when relevant.
# This is recall, not training - model weights never change.
LCA_MEMORY=true

# How many remembered facts may be injected into a single turn.
LCA_MEMORY_MAX_INJECT=5

# ---- checkpoints ---------------------------------------------------------
# Snapshot files before the agent changes them, so any turn can be rolled
# back with /restore (or the Checkpoints panel in the web UI).
# Covers write_file and edit_file. Shell commands are NOT covered - use git.
LCA_CHECKPOINTS=true

# How many turns to keep before pruning the oldest. Stored under
# <project>/.agent/checkpoints/ (machine-local, gitignored).
LCA_CHECKPOINTS_KEEP=20

# ---- web UI (`lca serve`) ------------------------------------------------
# Interface to bind. 127.0.0.1 keeps the agent private to this machine,
# which is the default and what you usually want.
LCA_WEB_HOST=127.0.0.1

LCA_WEB_PORT=8787

# Shared secret required on every /api/* call. Leave empty on loopback.
# Binding a non-loopback host with no token makes LCA generate one and
# print the URL that carries it.
LCA_WEB_TOKEN=

# Serve your own static files instead of the built-in UI (optional).
LCA_WEB_DIR=
